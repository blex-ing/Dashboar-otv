{
  "name": "dashboar-otv",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-18",
  "assets": {
    "directory": "web/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "env": {
    "preview": {
      "name": "dashboard-otv-preview",
      "assets": {
        "directory": "web/dist",
        "binding": "ASSETS",
        "run_worker_first": true
      }
    }
  }
}
