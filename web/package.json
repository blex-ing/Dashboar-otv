{
  "name": "dashboard-otv-web",
  "private": true,
  "version": "0.3.4",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/bundle.mjs dev",
    "typecheck": "tsc --noEmit && tsc -p ../worker/tsconfig.json",
    "test": "node --test ../tests/*.test.mjs && python3 ../tests/schema_test.py",
    "build": "npm run typecheck && node scripts/bundle.mjs build",
    "check": "npm run build && npm test",
    "test:visual": "playwright test"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
