{
  "name": "dashboard-otv-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/bundle.mjs dev",
    "typecheck": "tsc --noEmit && tsc -p ../worker/tsconfig.json",
    "test": "node --test ../tests/*.test.mjs && python3 ../tests/schema_test.py",
    "build": "npm run typecheck && node scripts/bundle.mjs build",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "esbuild": "0.28.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
